# ==============================================================================
# DISCADORA CONSIGNADO PRO - VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================

# --- SUPABASE (BANCO DE DADOS & AUTENTICAÇÃO) ---
# URL da instância ativa do Supabase
NEXT_PUBLIC_SUPABASE_URL=https://arcaaeehnxluginzncfs.supabase.co
# Chave pública (anon) com RLS ativado
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_chave_anonima_supabase_aqui
# Chave administrativa (service_role) - OBRIGATÓRIA no servidor de produção para webhooks e jobs
SUPABASE_SERVICE_ROLE_KEY=sua_chave_service_role_aqui

# --- APLICAÇÃO ---
NEXT_PUBLIC_APP_URL=https://discadora-callcenter.vercel.app

# --- IA GENERATIVA (SOFIA) ---
# Chave da Google Gemini API para análise de conversas e atendimento Sofia
GEMINI_API_KEY=sua_gemini_api_key_aqui
# Chave da Groq Cloud para inferência ultrarrápida (Llama 3.1)
GROQ_API_KEY=sua_groq_api_key_aqui

# --- WEBHOOKS & SEGURANÇA BACKEND ---
# Token compartilhado para validação de webhooks de URA DTMF e PABX
URA_WEBHOOK_SECRET=token_secreto_da_sua_ura_aqui
# Segredo administrativo para operações de backend e sincronização
ADMIN_WEBHOOK_SECRET=segredo_administrativo_sistema_aqui

# --- GATEWAYS DE PAGAMENTO (SAAS COBRANÇA) ---
# Token de webhook gerado no painel da Asaas
ASAAS_WEBHOOK_TOKEN=token_do_webhook_asaas_aqui
# Segredo de webhook Pix da Efí / Gerencianet
EFI_WEBHOOK_SECRET=segredo_webhook_efi_pix_aqui
# Token de acesso da conta comercial Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=token_acesso_mercadopago_aqui
